{
  "name": "with-restful-prisma",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "npx biome format --write \"**/*.{ts,tsx,md}\"",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "format-and-lint:error": "biome check . --diagnostic-level=error"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.57.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.18",
    "lightningcss-win32-x64-msvc": "^1.30.2"
  }
}
