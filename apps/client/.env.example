# =============================================================================
# apps/client — Next.js end-user app
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# All other variables are server-only and never sent to the client.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Base URL of apps/api. All client-side fetch calls are routed through here.
# In production this should be your API's public URL (e.g. https://api.example.com).
NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Analytics & Feature Flags — PostHog
# -----------------------------------------------------------------------------

# PostHog project API key.
# Find it in PostHog → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host.
# Use https://app.posthog.com (US) or https://eu.posthog.com (EU).
# Self-hosted: your own PostHog instance URL.
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# PostHog environment used to filter feature flags.
# Typical values: development | staging | production
NEXT_PUBLIC_FEATURE_FLAG_ENV=development

# -----------------------------------------------------------------------------
# Observability — Sentry
# -----------------------------------------------------------------------------

# Sentry auth token used to upload source maps during the production build.
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# Only required in CI/CD — leave empty for local development.
SENTRY_AUTH_TOKEN=
