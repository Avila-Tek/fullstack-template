# =============================================================================
# apps/api — NestJS Business API
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Primary PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_db

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------

# Redis connection string used for Better Auth session storage.
# Format: redis://<host>:<port> or redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication — Better Auth
# -----------------------------------------------------------------------------

# Secret used to sign sessions and HMAC tokens. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL of this API, used by Better Auth to build callback URLs.
# Must match the origin the client app uses to reach the API.
BETTER_AUTH_URL=http://localhost:3000

# End-user Next.js app URL — used for CORS and OAuth redirects.
CLIENT_URL=http://localhost:3002

# Admin Next.js app URL — used for CORS and OAuth redirects.
ADMIN_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Password Hashing (Argon2id)
# -----------------------------------------------------------------------------
# These tune how expensive password hashing is. Defaults are production-safe.
# Only change if you have measured your server's capacity and know what you're doing.
# See: https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html

# Memory cost in KiB (default: 65536 = 64 MB)
ARGON2_MEMORY_COST=65536

# Number of iterations (default: 3)
ARGON2_TIME_COST=3

# Number of parallel threads (default: 4)
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------

# Google OAuth 2.0 credentials.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# reCAPTCHA
# -----------------------------------------------------------------------------

# Set to "true" in local development to bypass reCAPTCHA verification.
# Never set this in production or CI.
SKIP_CAPTCHA=

# Google reCAPTCHA v3 secret key (server-side validation).
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_V3_SECRET_KEY=

# Google reCAPTCHA v2 (checkbox) secret key, used as a fallback.
RECAPTCHA_V2_SECRET_KEY=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# TCP port the NestJS HTTP server listens on.
PORT=3000

# Runtime environment. One of: development | production | qa
NODE_ENV=development

# Pino log level. One of: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Observability — Sentry
# -----------------------------------------------------------------------------

# Data Source Name for Sentry error tracking.
# Find it in your Sentry project settings → Client Keys.
SENTRY_DSN=

# Git commit SHA injected at CI build time: GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=

# Sentry auth token used to upload source maps during the production build.
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# Sentry organization slug (shown in your Sentry URL: sentry.io/organizations/<slug>)
SENTRY_ORG=

# Sentry project slug.
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Observability — OpenTelemetry
# -----------------------------------------------------------------------------

# OTLP gRPC endpoint for traces (e.g. Grafana Tempo, Jaeger, Honeycomb).
# Default points to a local Jaeger/Tempo instance.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name reported in traces and Sentry scope.
OTEL_SERVICE_NAME=api
