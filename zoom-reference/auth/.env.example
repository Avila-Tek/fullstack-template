# Auth Service — own database (separate from apps/api DATABASE_URL)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth_db

# Better Auth
# In production, source from GCP Secret Manager:
# BETTER_AUTH_SECRET=projects/zoom-prod/secrets/BETTER_AUTH_SECRET/versions/latest
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_API_KEY=your-better-auth-key

# Public base URL of this auth service — used as the JWT "iss" (issuer) claim
AUTH_BASE_URL=http://localhost:3001

# Verification email config
VERIFICATION_RESEND_MAX=3
VERIFICATION_TOKEN_TTL_HOURS=24

# Session config
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Trusted origins for CORS (Angular SPAs) and orchestrator
CLIENT_URL=http://localhost:4200
ORCHESTRATOR_URL=http://localhost:3000

# Social OAuth providers
# In production, source client secrets from GCP Secret Manager:
# GOOGLE_CLIENT_SECRET=projects/zoom-prod/secrets/GOOGLE_CLIENT_SECRET/versions/latest
# FACEBOOK_CLIENT_SECRET=projects/zoom-prod/secrets/FACEBOOK_CLIENT_SECRET/versions/latest
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_GOOGLE_ENABLED=true

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
SOCIAL_AUTH_FACEBOOK_ENABLED=true

# Brute-force login protection (per normalized email)
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCK_WINDOW_SECONDS=900

# Rate limiting — sign-up (defaults: 5 attempts per 3600s window)
SIGN_UP_RATE_LIMIT_MAX=5
SIGN_UP_RATE_LIMIT_WINDOW_SECONDS=3600

# Rate limiting — social sign-in (defaults: 5 attempts per 600s window)
SOCIAL_RATE_LIMIT_MAX=5
SOCIAL_RATE_LIMIT_WINDOW_SECONDS=600

# Password reset — token TTL and rate limits
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Per-email rate limit for /request-password-reset (defaults: 3 per hour)
PASSWORD_RESET_EMAIL_RATE_LIMIT_MAX=3
PASSWORD_RESET_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
# Per-IP rate limit for /request-password-reset and /reset-password (handled by BA customRules)
PASSWORD_RESET_IP_RATE_LIMIT_MAX=10
PASSWORD_RESET_IP_RATE_LIMIT_WINDOW_SECONDS=3600
# Number of previous password hashes to check against for reuse
PASSWORD_HISTORY_DEPTH=5

# Password change — rate limits (defaults: 5 attempts per 600s window)
CHANGE_PASSWORD_RATE_LIMIT_MAX=5
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=600

# Email change — rate limits (defaults: 5 attempts per 300s window)
CHANGE_EMAIL_RATE_LIMIT_MAX=5
CHANGE_EMAIL_RATE_LIMIT_WINDOW_SECONDS=300

# Pending terms store TTL in seconds (default: 600)
PENDING_TERMS_TTL_SECONDS=600

# OAuth system context store TTL in seconds (default: 600 — must complete OAuth round-trip before expiry)
OAUTH_SYSTEM_CTX_TTL_SECONDS=600

# Captcha (Cloudflare Turnstile)
# In production, source from GCP Secret Manager:
# TURNSTILE_SECRET_KEY=projects/zoom-prod/secrets/TURNSTILE_SECRET_KEY/versions/latest
SKIP_CAPTCHA=true
TURNSTILE_SECRET_KEY=

# 2FA OTP delivery settings (S-005)
OTP_TTL_SECONDS=300
OTP_MAX_SENDS=3
OTP_WINDOW_SECONDS=600
TOTP_ISSUER_NAME=Zoom

# 2FA challenge configuration (S-007) — maximum failed attempts before lockout
# TOTP_MAX_FAILURES: max wrong TOTP codes before 15-min lock (default: 3)
TOTP_MAX_FAILURES=3
# OTP_MAX_ATTEMPTS: max wrong OTP codes per code before requiring new code (default: 3)
OTP_MAX_ATTEMPTS=3
# TOTP_REPLAY_WINDOW_SECONDS: replay prevention window covering ±1 TOTP period (default: 90)
TOTP_REPLAY_WINDOW_SECONDS=90

# 2FA settings page URL (S-014) — used in failed login alert email
TWO_FACTOR_SETTINGS_URL=http://localhost:4200/settings/two-factor

# Zoom API shared credentials (auth shared between SMS and email adapters)
# In production, source ZOOM_PASSWORD from GCP Secret Manager:
# ZOOM_PASSWORD=projects/zoom-prod/secrets/ZOOM_PASSWORD/versions/latest
ZOOM_AUTH_URL=
ZOOM_USER=
ZOOM_PASSWORD=

# Zoom SMS gateway
ZOOM_SMS_API_URL=
ZOOM_SMS_SENDER_ID=

# Zoom Email gateway
ZOOM_EMAIL_API_URL=
ZOOM_EMAIL_SENDER_ID=
EMAIL_LOGO_URL=https://storage.googleapis.com/zoom-public-files-dev/zoom-logo.png

# Zoom API resilience (applies to auth, SMS, and email fetch calls)
ZOOM_API_TIMEOUT_MS=10000
ZOOM_API_RETRY_MAX=3
ZOOM_API_RETRY_BACKOFF_MS=200

# Admin API secret — used by POST /admin/users/:id/unlock (Authorization: Bearer <secret>)
# In production, source from GCP Secret Manager:
# ADMIN_SECRET=projects/zoom-prod/secrets/ADMIN_SECRET/versions/latest
ADMIN_SECRET="<generate: openssl rand -base64 32>"

# Internal service secret — shared with orchestrator for POST /internal/users/provision
AUTH_SERVICE_SECRET="<generate: openssl rand -base64 32>"

# HMAC-SHA256 secret for API key hashing — a stolen DB alone is not sufficient without this key
# In production, source from GCP Secret Manager:
# API_KEY_HMAC_SECRET=projects/zoom-prod/secrets/API_KEY_HMAC_SECRET/versions/latest
API_KEY_HMAC_SECRET=<generate: openssl rand -base64 32>

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Sentry error monitoring
SENTRY_DSN=
# Injected at CI build time: GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=
# SENTRY_AUTH_TOKEN — build-time CI credential. In production, source from GCP Secret Manager:
# SENTRY_AUTH_TOKEN=projects/zoom-prod/secrets/SENTRY_AUTH_TOKEN/versions/latest
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Redis
REDIS_URL=redis://localhost:6379
# PEM-encoded CA cert for `rediss://` TLS verification (e.g. GCP Memorystore).
# Leave unset for plain `redis://` connections.
REDIS_CA_CERT=

# Platform
TERMS_CACHE_TTL_SECONDS=300

# NestJS rate limiting (global throttler)
RATE_TTL=60000
RATE_LIMIT=100

# Seed script (npm run db:seed)
SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_NAME=Platform Admin
SEED_PLATFORM_ADMIN_PASSWORD=<strong-password>
# Optional — JSON array of systems to seed. Leave empty to skip.
SEED_SYSTEMS=[{"name":"My App","slug":"my-app","apiBaseUrl":"https://api.myapp.com","accessModel":"open"}]

# Argon2id tuning (optional — defaults are secure)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# OpenTelemetry
OTEL_SERVICE_NAME=zoom-auth
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# GCP Secret Manager integration (see packages/config/README.md)
# -----------------------------------------------------------------------------
# Set USE_GCP_SECRETS=true in production. The loader scans every env value above;
# any value matching `projects/<id>/secrets/<name>[/versions/<v>]` is resolved to
# the plain secret string before Zod validation. When unset or false, the loader
# is a full no-op and .env values are used as-is (local dev / tests).
USE_GCP_SECRETS=false
# Optional — enforces that every locator targets this project; mismatch fails startup.
GCP_PROJECT_ID=

# PII column encryption key — 256-bit hex string. Generate: openssl rand -hex 32
PII_ENCRYPTION_KEY="<generate: openssl rand -hex 32>"
